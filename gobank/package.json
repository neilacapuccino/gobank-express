{
  "name": "gobank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:client": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "card:setup-key": "node --import tsx scripts/setup-card-key.ts",
    "dev": "next dev --turbo -p 3001",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx,json}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx,json}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "postinstall": "prisma generate",
    "preview": "next build && next start",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit --incremental false",
    "check:ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test": "npm run test:bitcoin && npm run test:profile && npm run test:savings && npm run test:auth && npm run test:card && npm run test:amount-input",
    "test:auth": "node --import tsx --test src/features/auth/auth.test.ts",
    "test:auth:integration": "node --conditions=react-server --import tsx scripts/verify-auth.ts",
    "test:card": "node --conditions=react-server --import tsx --test src/features/card/card.cvv.test.ts",
    "test:card:integration": "node --conditions=react-server --import tsx scripts/verify-card.ts",
    "test:amount-input": "node --import tsx --test src/shared/lib/amount-input.test.ts",
    "test:transfers:integration": "node --conditions=react-server --import tsx scripts/verify-transfers-requests.ts",
    "test:payments:integration": "node --conditions=react-server --import tsx scripts/verify-payments.ts",
    "test:savings": "node --import tsx --test src/shared/lib/savings-interest.test.ts",
    "test:enrollment:savings": "node --conditions=react-server --import tsx scripts/verify-enrollment-savings.ts",
    "test:bitcoin": "node --import tsx --test src/features/bitcoin/bitcoin.rules.test.ts src/features/bitcoin/bitcoin.candles.test.ts src/features/bitcoin/bitcoin.cache.test.ts",
    "test:bitcoin:integration": "node --conditions=react-server --import tsx scripts/verify-bitcoin.ts",
    "test:profile": "node --conditions=react-server --import tsx --test src/features/account/profile-photo.test.ts",
    "test:profile:integration": "node --conditions=react-server --import tsx scripts/verify-profile-photo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "lucide-react": "^1.34.0",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "jiti": "^2.7.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@10.9.2"
}
